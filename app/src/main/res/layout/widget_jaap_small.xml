<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- LEFT: Mala Icon + Mantra Name + Mala # -->
    <LinearLayout
        android:id="@+id/widget_left_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:gravity="center_vertical|start">

        <ImageView
            android:id="@+id/widget_icon_mala"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_om_mala"
            android:contentDescription="Mala Icon" />

        <TextView
            android:id="@+id/widget_mantra_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Radhe Radhe"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_mala_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mala #2"
            android:textColor="#C084FC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RIGHT: Jaap Tap Area with circular count -->
    <FrameLayout
        android:id="@+id/widget_tap_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_bead_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="Tap to Jaap" />
    </FrameLayout>

</LinearLayout>
